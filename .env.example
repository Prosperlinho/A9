# Frontend Convex deployment URL (safe to expose to the browser)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Set these in Convex environment variables, never in VITE_* variables.
# Use Paystack TEST credentials during development.
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_MODE=test
# PAYSTACK_CALLBACK_URL=http://localhost:5173/
# PAYSTACK_TRANSFER_ENABLED=false
# PAYSTACK_TRANSFER_SOURCE=balance
# PAYSTACK_LIVE_ENABLED=false
